# Application
NODE_ENV=development
PORT=18320
API_PREFIX=api
# Comma-separated browser origins allowed to send the session cookie.
# A wildcard is not usable here: credentialed requests require exact origins.
CORS_ORIGINS=http://localhost:18321

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=18322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=web_backend
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Auth — the signed token is delivered in an httpOnly cookie, not a header.
# Minimum 32 chars. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-in-production-min-32-characters-long
# Applies to both the token and the cookie lifetime.
AUTH_TOKEN_EXPIRES_IN=1d
AUTH_COOKIE_NAME=access_token
# Cross-site cookies are intentionally unsupported until unsafe requests have
# dedicated CSRF protection. Use lax (default) or strict.
AUTH_COOKIE_SAME_SITE=lax
# Defaults to true when NODE_ENV=production. Set explicitly behind HTTPS.
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=
AUTH_BCRYPT_ROUNDS=12

# Rate limiting (window in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Tighter budget for login/register.
AUTH_THROTTLE_LIMIT=10

# Startup accounts (optional). At backend startup, a missing account is created
# with this role when its password is set. Existing accounts keep their
# password, role, and status; the one exception is that the admin account is
# promoted and reactivated when no active admin exists. Use real secrets here.
# BOOTSTRAP_ADMIN_EMAIL=first.admin@usth.edu.vn
# BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# BOOTSTRAP_ADMIN_NAME="Campus Administrator"
# BOOTSTRAP_STAFF_EMAIL=first.staff@usth.edu.vn
# BOOTSTRAP_STAFF_PASSWORD=change-me-staff-password
# BOOTSTRAP_STAFF_NAME="Campus Staff"
