# Committed on purpose: these are throwaway local test values, not secrets.
# Real environment variables always win, so CI can override any of them.
NODE_ENV=test
PORT=18320
API_PREFIX=api
CORS_ORIGINS=http://localhost:18321

DB_HOST=localhost
DB_PORT=18322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=web_backend_test
DB_SYNCHRONIZE=false
DB_LOGGING=false

AUTH_JWT_SECRET=test-only-secret-value-at-least-32-characters
AUTH_TOKEN_EXPIRES_IN=15m
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Lowest allowed cost, to keep the suite fast.
AUTH_BCRYPT_ROUNDS=10

THROTTLE_TTL=60
# Effectively disabled, so rate limiting does not make tests flaky.
THROTTLE_LIMIT=100000
AUTH_THROTTLE_LIMIT=100000
