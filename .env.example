# Copy to .env before running Docker Compose.
# Generate a local secret with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-me

# Host ports and browser-visible URLs
BACKEND_PORT=3000
FRONTEND_PORT=3001
DB_HOST_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:3000/api
CORS_ORIGINS=http://localhost:3001

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=web_backend

# Local HTTP cookie settings. Production must use HTTPS and set both values.
NODE_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
