# Copy to .env before running Docker Compose.
# Generate a local secret with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-me

# Host ports and browser-visible URLs
BACKEND_PORT=18320
FRONTEND_PORT=18321
DB_HOST_PORT=18322
NEXT_PUBLIC_API_URL=http://localhost:18320/api
CORS_ORIGINS=http://localhost:18321

# Private subnet for this Compose project. Change it only if it overlaps a host
# route, VPN, or another Docker network.
DOCKER_SUBNET=10.203.250.0/24

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=web_backend

# Local HTTP cookie settings. Production must use HTTPS and set both values.
NODE_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Startup accounts (optional). At backend startup, a missing account is created
# with this role when its password is set. Existing accounts keep their
# password, role, and status; the one exception is that the admin account is
# promoted and reactivated when no active admin exists. Use real secrets here.
# BOOTSTRAP_ADMIN_EMAIL=first.admin@usth.edu.vn
# BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# BOOTSTRAP_ADMIN_NAME="Campus Administrator"
# BOOTSTRAP_STAFF_EMAIL=first.staff@usth.edu.vn
# BOOTSTRAP_STAFF_PASSWORD=change-me-staff-password
# BOOTSTRAP_STAFF_NAME="Campus Staff"
