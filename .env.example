# Copy to .env before running Docker Compose.
# Generate a local secret with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-me

# Host ports and browser-visible URLs
BACKEND_PORT=46120
FRONTEND_PORT=46121
DB_HOST_PORT=46122
NEXT_PUBLIC_API_URL=http://localhost:46120/api
CORS_ORIGINS=http://localhost:46121

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=web_backend

# Local HTTP cookie settings. Production must use HTTPS and set both values.
NODE_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
